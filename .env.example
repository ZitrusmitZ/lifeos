# ─── LifeOS Konfiguration ──────────────────────────────────────────────
# Kopieren nach .env und ausfüllen. Leere Werte = Integration ausgeschaltet.

# Öffentliche Basis-URL im Tailnet (für OAuth-Redirects), ohne Slash am Ende
APP_URL=https://lifeos.taila65db2.ts.net
APP_TZ=Europe/Berlin
DATA_DIR=/data

# true = Fixture-Daten statt echter APIs (für Demos/Screenshots)
DEMO_MODE=false

# ─── Sicherheit ────────────────────────────────────────────────────────
# Nur Anfragen über `tailscale serve` (Header Tailscale-User-Login) zulassen
REQUIRE_TAILSCALE_AUTH=true
# Kommagetrennt: `owner` (Besitzer dieses Servers), Tailscale-Nutzer-IDs oder Logins wie name@github.
# `owner` und IDs bleiben gültig, wenn sich der Login ändert (z. B. GitHub-Umbenennung). Leer = jeder im Tailnet.
ALLOWED_TAILSCALE_USERS=owner
# 32 Byte, base64:  openssl rand -base64 32
ENCRYPTION_KEY=
# Token für den iPhone-Kurzbefehl:  openssl rand -base64 24
INGEST_TOKEN=

# ─── Schule (WebUntis) ─────────────────────────────────────────────────
# Server z. B. nessa.webuntis.com; Schulname steht in der WebUntis-URL (?school=...)
UNTIS_SERVER=
UNTIS_SCHOOL=
UNTIS_USER=
UNTIS_PASSWORD=

# ─── Google (Kalender, Gmail, Drive – nur lesend) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Spotify (PKCE, kein Secret nötig) ─────────────────────────────────
SPOTIFY_CLIENT_ID=

# ─── GitHub (Fine-grained PAT, nur lesend) ─────────────────────────────
GITHUB_TOKEN=

# ─── Mail-Assistent (KI-Sortierung) ────────────────────────────────────
OPENAI_API_KEY=
# Standard: gpt-6-luna (0,10 $ / 0,50 $ pro 1 Mio. Token)
OPENAI_MODEL=
# Harte Monatsgrenze in US-Dollar (Standard 1)
OPENAI_MONTHLY_BUDGET_USD=
# Token für den systemd-Timer und den LifeOS-Agenten (bootstrap-vps.sh erzeugt ihn):  openssl rand -hex 24
CRON_TOKEN=
# Unix-Socket des Agenten für den Chat im Dashboard (Standard /run/lifeos-agent/web.sock, per compose.yaml gemountet)
AGENT_SOCKET=

# ─── Wetter & News ─────────────────────────────────────────────────────
# Fallback-Standort, solange der Browser keinen Standort freigibt
DEFAULT_LAT=52.52
DEFAULT_LON=13.405
# Leer lassen = Standardquellen (Tagesschau, Politik, rbb24 Region + Blaulicht, heise, The Verge, Hacker News)
# Eigene Liste: Name|URL|Kategorie, kommagetrennt (Kategorien: Allgemein, Politik, Region, Blaulicht, Tech)
NEWS_FEEDS=
# Orte, deren Meldungen hervorgehoben werden
NEWS_LOCAL_KEYWORDS=
