# ─── LifeOS Konfiguration ──────────────────────────────────────────────
# Kopieren nach .env und ausfüllen. Leere Werte = Integration ausgeschaltet.

# Öffentliche Basis-URL im Tailnet (für OAuth-Redirects), ohne Slash am Ende
APP_URL=https://lifeos.taila65db2.ts.net
APP_TZ=Europe/Berlin
DATA_DIR=/data

# true = Fixture-Daten statt echter APIs (für Demos/Screenshots)
DEMO_MODE=false

# ─── Sicherheit ────────────────────────────────────────────────────────
# Nur Anfragen über `tailscale serve` (Header Tailscale-User-Login) zulassen
REQUIRE_TAILSCALE_AUTH=true
# Kommagetrennt: `owner` (Besitzer dieses Servers), Tailscale-Nutzer-IDs oder Logins wie name@github.
# `owner` und IDs bleiben gültig, wenn sich der Login ändert (z. B. GitHub-Umbenennung). Leer = jeder im Tailnet.
ALLOWED_TAILSCALE_USERS=owner
# 32 Byte, base64:  openssl rand -base64 32
ENCRYPTION_KEY=
# Token für den iPhone-Kurzbefehl:  openssl rand -base64 24
INGEST_TOKEN=

# ─── Schule (WebUntis) ─────────────────────────────────────────────────
# Server z. B. nessa.webuntis.com; Schulname steht in der WebUntis-URL (?school=...)
UNTIS_SERVER=
UNTIS_SCHOOL=
UNTIS_USER=
UNTIS_PASSWORD=

# ─── Google (Kalender, Gmail, Drive – nur lesend) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Spotify (PKCE, kein Secret nötig) ─────────────────────────────────
SPOTIFY_CLIENT_ID=

# ─── GitHub (Fine-grained PAT, nur lesend) ─────────────────────────────
GITHUB_TOKEN=

# ─── Homeserver: Pi-hole & Nextcloud (optional) ────────────────────────
# Interne Adressen im Docker-Netz `homeserver_default` (LifeOS muss dort mit drin sein, siehe docs/SETUP.md).
# Pi-hole: App-Passwort aus Einstellungen → Web-Oberfläche/API (nicht das Login-Passwort)
PIHOLE_URL=
PIHOLE_APP_PASSWORD=
# Link zur Admin-Oberfläche im Browser, z. B. https://homeserver.<tailnet>.ts.net:8444
PIHOLE_PUBLIC_URL=
# Nextcloud: App-Passwort mit `occ user:auth-tokens:add <nutzer>` (Admin-Nutzer für Speicherangaben)
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
# z. B. https://homeserver.<tailnet>.ts.net:8443
NEXTCLOUD_PUBLIC_URL=
# Freigabe-Links aus „Dateien“ (/d/<token>) – öffentlich über den eigenen Container lifeos-share (Funnel), siehe docs/SETUP.md
# z. B. https://lifeos-share.<tailnet>.ts.net (leer = APP_URL, dann nur im Tailnet erreichbar)
SHARE_PUBLIC_URL=
# Container lifeos-share einschalten und einmalig anmelden: Auth-Key mit Tag tag:share (tskey-auth-…)
# COMPOSE_PROFILES=share
SHARE_TS_AUTHKEY=

# ─── Mail-Assistent (KI-Sortierung) ────────────────────────────────────
OPENAI_API_KEY=
# Standard: gpt-6-luna (0,10 $ / 0,50 $ pro 1 Mio. Token)
OPENAI_MODEL=
# Harte Monatsgrenze in US-Dollar (Standard 1)
OPENAI_MONTHLY_BUDGET_USD=
# Token für den systemd-Timer und den LifeOS-Agenten (bootstrap-vps.sh erzeugt ihn):  openssl rand -hex 24
CRON_TOKEN=
# Unix-Socket des Agenten für den Chat im Dashboard (Standard /run/lifeos-agent/web.sock, per compose.yaml gemountet)
AGENT_SOCKET=

# ─── Island (Laptop, Repo ~/AIStack/island) ───────────────────────────
# Schlüssel bleiben hier auf dem Server, Kosten zählen ins KI-Monatsbudget (OPENAI_MONTHLY_BUDGET_USD). Leer = Route antwortet 503.
# TypeSafe Jev über OpenRouter für POST /api/jev (0,042 $ pro 1 Mio. Input-Token, Output gratis)
OPENROUTER_API_KEY=
# Standard: typesafe/jev-1.13
JEV_MODEL=
# Spracherkennung über Groq whisper-large-v3-turbo für POST /api/stt (0,04 $ pro Audiostunde, mind. 10 s je Aufnahme).
# Leer = kostenlos über FreeLLM, das der Agent auf dem Host fragt (FREE_LLM_KEY in agent.env); ohne beides 503.
GROQ_API_KEY=

# ─── Wetter & News ─────────────────────────────────────────────────────
# Fallback-Standort, solange der Browser keinen Standort freigibt
DEFAULT_LAT=52.52
DEFAULT_LON=13.405
# Leer lassen = Standardquellen (Tagesschau, Politik, rbb24 Region + Blaulicht, heise, The Verge, Hacker News)
# Eigene Liste: Name|URL|Kategorie, kommagetrennt (Kategorien: Allgemein, Politik, Region, Blaulicht, Tech)
NEWS_FEEDS=
# Orte, deren Meldungen hervorgehoben werden
NEWS_LOCAL_KEYWORDS=
