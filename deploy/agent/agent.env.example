# ─── LifeOS-Agent (Telegram + Web-Chat im Dashboard) ───────────────────
# Installiert nach /etc/lifeos-agent/agent.env (root:root 600). Nach Änderungen: sudo systemctl restart lifeos-agent

# ─── Telegram (optional) ───────────────────────────────────────────────
# Leer lassen = nur Web-Chat im LifeOS-Dashboard; Briefing, Erinnerungen und Alarme landen dann dort.
# Token von @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Deine eigene User-ID (Zahl) von @userinfobot – nur diese ID wird bedient
TELEGRAM_ALLOWED_USER_ID=
# Nachrichten pro Minute, danach wird ignoriert
AGENT_RATE_LIMIT_PER_MIN=20

# ─── Claude (Pro-Abo, nur über die offizielle CLI) ─────────────────────
# Einmalig: sudo -u lifeos -H /var/lib/lifeos-agent/.local/bin/claude setup-token
# Das Token liest nur die CLI selbst – der Agent-Code fasst es nicht an.
CLAUDE_CODE_OAUTH_TOKEN=
# Modell-Aliase der CLI (--model)
CLAUDE_MODEL_SIMPLE=haiku
CLAUDE_MODEL_COMPLEX=sonnet
CLAUDE_MODEL_HARD=opus

# ─── Connectors (Gmail, Google Calendar, Notion, Composio, Canva …) ────
# Nutzt die Connectors und synchronisierten Plugins/Skills deines claude.ai-Kontos. Voraussetzung: normaler
# claude.ai-Login für lifeos (das setup-token oben kann keine Connectors und wird dann ignoriert):
#   cd /tmp && sudo -u lifeos -H env -i HOME=/var/lib/lifeos-agent PATH=/var/lib/lifeos-agent/.local/bin:/usr/bin:/bin claude auth login --claudeai
# Lesen läuft sofort, jede ändernde Aktion (Mail senden, Termin anlegen, Notion schreiben …) erst nach „Ausführen“ im Chat.
AGENT_CONNECTORS=false
# Gesamtzeit einer Anfrage inkl. Warten auf deine Bestätigung (ms)
AGENT_CONNECTOR_TIMEOUT_MS=900000
# leer = CLI-Standard
CLAUDE_MAX_TURNS=

# ─── Lokales Modell (Ollama) ───────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:3b (Default) oder llama3.2:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000

# ─── API-Provider (vorbereitet, AUS) ───────────────────────────────────
# Nur mit echtem API-Key, nie mit dem Abo-Token. Ohne Preise und Budget bleibt er aus.
ENABLE_API_PROVIDER=false
AGENT_ANTHROPIC_API_KEY=
AGENT_API_MODEL=
AGENT_API_MONTHLY_BUDGET_USD=0
AGENT_API_PRICE_IN_PER_MTOK=
AGENT_API_PRICE_OUT_PER_MTOK=

# ─── FreeLLM (FreeLLMAPI, OpenAI-kompatibel) ───────────────────────────
# Springt ein, wenn das Pro-Kontingent leer ist (statt Warteschlange). Nur Chat – keine Connectors, keine Tools.
# Key: FreeLLMAPI-Oberfläche (http://127.0.0.1:3001) → API-Keys. Modelle: Liste, der Reihe nach probiert –
# `auto` zuletzt (wählt auch Reasoning-Modelle, die schlechter Deutsch antworten). Verfügbare: GET /v1/models
ENABLE_FREE_PROVIDER=false
FREE_LLM_URL=http://127.0.0.1:3001
FREE_LLM_KEY=
FREE_LLM_MODEL=gemini-flash,deepseek-v4-flash,llama-3.3-70b,auto
# Höchstzeit pro Modell (ms), danach das nächste der Liste
FREE_LLM_MODEL_TIMEOUT_MS=30000
# Spracherkennung für /api/stt (Laptop-Island), solange in der LifeOS-.env kein GROQ_API_KEY steht. Braucht nur
# FREE_LLM_KEY (ENABLE_FREE_PROVIDER egal). `whisper-1` = FreeLLM wählt ein Whisper und weicht bei Limits aus.
FREE_LLM_STT_MODEL=whisper-1

# ─── Server-Tools ──────────────────────────────────────────────────────
# true = ändernde Aktionen nur simulieren (auch per `--dry-run`)
AGENT_DRY_RUN=false
# Name:Art (systemd | docker) – muss zu /etc/lifeos-agent/helper.conf passen
AGENT_SERVICES=ollama:systemd,tailscaled:systemd,playit:systemd,lifeos:docker,minecraft:docker,pihole:docker,nextcloud:docker,nextcloud-db:docker
AGENT_BACKUP_TARGETS=lifeos,minecraft,offsite
AGENT_GIT_PROJECTS=lifeos
# „Aufgabe: …“ (run_task): Ordner, in denen Claude Dateien bearbeiten darf (zusätzlich zum Workspace), kommagetrennt.
# install_agent.sh legt sie an, gibt lifeos per ACL Schreibrechte und trägt sie in die systemd-Unit ein.
# Nichts unter /home (ProtectHome) und keine Systemordner.
AGENT_FILE_DIRS=/srv/homeserver
# true = Claude darf in run_task Befehle ausführen (als Nutzer lifeos), jeden einzeln erst nach „Ausführen“
AGENT_TASK_SHELL=true

# ─── Standard-Jobs (true/false) ────────────────────────────────────────
AGENT_JOB_BRIEFING=true
AGENT_JOB_HEALTH=true
AGENT_JOB_LEARNING=true
AGENT_HEALTH_DISK_PCT=85
AGENT_HEALTH_RAM_PCT=90
AGENT_HEALTH_RAM_MINUTES=10
AGENT_HEALTH_TEMP_C=80

# ─── Notion (optional, für das Morgen-Briefing) ────────────────────────
# Interne Integration anlegen: https://www.notion.so/profile/integrations → Token kopieren,
# dann in der Aufgaben-Datenbank „…“ → Verbindungen → Integration hinzufügen.
NOTION_TOKEN=
# 32-stellige ID aus der Datenbank-URL (notion.so/<workspace>/<ID>?v=…)
NOTION_TASKS_DB_ID=
NOTION_PROP_TITLE=Aufgabe
NOTION_PROP_STATUS=Status
NOTION_PROP_DATE=Datum/Uhrzeit
NOTION_PROP_PRIORITY=Priorität
NOTION_PROP_CATEGORY=Kategorie
NOTION_DONE_STATUSES=Erledigt,Done,Fertig

# ─── Kalender über LifeOS (optional) ───────────────────────────────────
LIFEOS_URL=http://127.0.0.1:3000
# = CRON_TOKEN aus /opt/lifeos/.env (install_agent.sh trägt ihn automatisch ein).
# Gleichzeitig der Schlüssel für den Web-Chat: ohne ihn bleibt der Chat im Dashboard aus.
LIFEOS_CRON_TOKEN=
# Unix-Socket für den Web-Chat (compose.yaml mountet /run/lifeos-agent in den Container)
AGENT_WEB_SOCKET=/run/lifeos-agent/web.sock

# ─── Sonstiges ─────────────────────────────────────────────────────────
AGENT_TZ=Europe/Berlin
AGENT_DATA_DIR=/var/lib/lifeos-agent
# Health-Endpunkt: nur 127.0.0.1 oder Tailscale-IP (100.x), nie 0.0.0.0
AGENT_HEALTH_HOST=127.0.0.1
AGENT_HEALTH_PORT=8788

# ─── Agent-Modus ─────────────────────────────────────────────────────────
# Nicht-triviale Nachrichten laufen als Claude-Code-Sitzung mit Werkzeugen (Dateien, Befehle/root per Klick, LifeOS-Tools,
# Coding-Agents). false = reiner Chat wie früher. /neu beginnt eine neue Sitzung, /stop bricht ab.
AGENT_MODE=true
# AGENT_MODE_MAX_TURNS=80
# AGENT_MODE_TIMEOUT_MS=2700000
# AGENT_SESSION_IDLE_MIN=240

# ─── Root-Befehle + Coding-Agents ───────────────────────────────────────
# Root: „sudo <befehl>“ im Chat bzw. root_command in run_task/Coding-Agents – JEDER Befehl erst nach „Ausführen“.
# Läuft über den Helfer außerhalb der Sandbox; Protokoll: /var/log/lifeos-agent/root-exec.log. Hauptschalter: ROOT_EXEC in helper.conf.
AGENT_ROOT_EXEC=true
# Berechtigungsregeln/Auto-Modus (JSON, siehe README). Leer = <AGENT_DATA_DIR>/permissions.json; im Dashboard unter /agent/berechtigungen editierbar
#AGENT_PERMISSIONS_FILE=
# Coding-Agents: „code lifeos: <aufgabe>“ → Claude Code als CODE_USER (helper.conf) in eigenem Worktree, Ergebnis als PR.
# Namen müssen in CODE_REPOS (helper.conf) stehen.
AGENT_CODE_REPOS=lifeos
# Optional (landen in /etc/lifeos-agent/coder.env): Modell, FreeLLM-Modell, Fallback aus, Test mit FreeLLM erzwingen
# CODER_MODEL=sonnet
# CODER_FREE_MODEL=auto
# CODER_FREE_FALLBACK=false
# CODER_FORCE_FREE=1
