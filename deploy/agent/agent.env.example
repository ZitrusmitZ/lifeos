# ─── LifeOS-Agent (Telegram + Web-Chat im Dashboard) ───────────────────
# Installiert nach /etc/lifeos-agent/agent.env (root:root 600). Nach Änderungen: sudo systemctl restart lifeos-agent

# ─── Telegram (optional) ───────────────────────────────────────────────
# Leer lassen = nur Web-Chat im LifeOS-Dashboard; Briefing, Erinnerungen und Alarme landen dann dort.
# Token von @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Deine eigene User-ID (Zahl) von @userinfobot – nur diese ID wird bedient
TELEGRAM_ALLOWED_USER_ID=
# Nachrichten pro Minute, danach wird ignoriert
AGENT_RATE_LIMIT_PER_MIN=20

# ─── Claude (Pro-Abo, nur über die offizielle CLI) ─────────────────────
# Einmalig: sudo -u lifeos -H /var/lib/lifeos-agent/.local/bin/claude setup-token
# Das Token liest nur die CLI selbst – der Agent-Code fasst es nicht an.
CLAUDE_CODE_OAUTH_TOKEN=
# Modell-Aliase der CLI (--model)
CLAUDE_MODEL_SIMPLE=haiku
CLAUDE_MODEL_COMPLEX=sonnet
CLAUDE_MODEL_HARD=opus
# leer = CLI-Standard
CLAUDE_MAX_TURNS=

# ─── Lokales Modell (Ollama) ───────────────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5:3b (Default) oder llama3.2:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=60000

# ─── API-Provider (vorbereitet, AUS) ───────────────────────────────────
# Nur mit echtem API-Key, nie mit dem Abo-Token. Ohne Preise und Budget bleibt er aus.
ENABLE_API_PROVIDER=false
AGENT_ANTHROPIC_API_KEY=
AGENT_API_MODEL=
AGENT_API_MONTHLY_BUDGET_USD=0
AGENT_API_PRICE_IN_PER_MTOK=
AGENT_API_PRICE_OUT_PER_MTOK=

# ─── Server-Tools ──────────────────────────────────────────────────────
# true = ändernde Aktionen nur simulieren (auch per `--dry-run`)
AGENT_DRY_RUN=false
# Name:Art (systemd | docker) – muss zu /etc/lifeos-agent/helper.conf passen
AGENT_SERVICES=ollama:systemd,tailscaled:systemd,playit:systemd,lifeos:docker,minecraft:docker
AGENT_BACKUP_TARGETS=lifeos,minecraft,offsite
AGENT_GIT_PROJECTS=lifeos

# ─── Standard-Jobs (true/false) ────────────────────────────────────────
AGENT_JOB_BRIEFING=true
AGENT_JOB_HEALTH=true
AGENT_JOB_LEARNING=true
AGENT_HEALTH_DISK_PCT=85
AGENT_HEALTH_RAM_PCT=90
AGENT_HEALTH_RAM_MINUTES=10
AGENT_HEALTH_TEMP_C=80

# ─── Notion (optional, für das Morgen-Briefing) ────────────────────────
# Interne Integration anlegen: https://www.notion.so/profile/integrations → Token kopieren,
# dann in der Aufgaben-Datenbank „…“ → Verbindungen → Integration hinzufügen.
NOTION_TOKEN=
# 32-stellige ID aus der Datenbank-URL (notion.so/<workspace>/<ID>?v=…)
NOTION_TASKS_DB_ID=
NOTION_PROP_TITLE=Aufgabe
NOTION_PROP_STATUS=Status
NOTION_PROP_DATE=Datum/Uhrzeit
NOTION_PROP_PRIORITY=Priorität
NOTION_PROP_CATEGORY=Kategorie
NOTION_DONE_STATUSES=Erledigt,Done,Fertig

# ─── Kalender über LifeOS (optional) ───────────────────────────────────
LIFEOS_URL=http://127.0.0.1:3000
# = CRON_TOKEN aus /opt/lifeos/.env (install_agent.sh trägt ihn automatisch ein).
# Gleichzeitig der Schlüssel für den Web-Chat: ohne ihn bleibt der Chat im Dashboard aus.
LIFEOS_CRON_TOKEN=
# Unix-Socket für den Web-Chat (compose.yaml mountet /run/lifeos-agent in den Container)
AGENT_WEB_SOCKET=/run/lifeos-agent/web.sock

# ─── Sonstiges ─────────────────────────────────────────────────────────
AGENT_TZ=Europe/Berlin
AGENT_DATA_DIR=/var/lib/lifeos-agent
# Health-Endpunkt: nur 127.0.0.1 oder Tailscale-IP (100.x), nie 0.0.0.0
AGENT_HEALTH_HOST=127.0.0.1
AGENT_HEALTH_PORT=8788
