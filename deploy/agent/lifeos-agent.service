[Unit]
Description=LifeOS-Agent (Telegram + Web-Chat im Dashboard)
After=network-online.target ollama.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=lifeos
Group=lifeos
WorkingDirectory=/opt/lifeos-agent
EnvironmentFile=/etc/lifeos-agent/agent.env
Environment=HOME=/var/lib/lifeos-agent
Environment=PATH=/var/lib/lifeos-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/local/bin/node --disable-warning=ExperimentalWarning src/agent/main.ts
Restart=on-failure
RestartSec=10
# Exit 2 = Konfiguration fehlt (Tokens) → nicht endlos neu starten
RestartPreventExitStatus=2
# Minecraft hat Vorrang; 2G, weil lokales Whisper (small) beim Erkennen ≈ 1 GB braucht
MemoryMax=2G
Nice=5
CPUWeight=50
# Härtung (kein NoNewPrivileges: sudo für den Root-Helfer braucht setuid)
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/lifeos-agent
# Web-Chat: /run/lifeos-agent/web.sock, Ordner wird in den LifeOS-Container gemountet.
# Preserve: der Ordner überlebt Neustarts, sonst zeigt der Bind-Mount im Container ins Leere.
RuntimeDirectory=lifeos-agent
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
