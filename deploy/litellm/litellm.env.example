# FreeLLM (LiteLLM-Proxy) → /etc/litellm/litellm.env (root:root 600)
# Mindestens einen Key eintragen, danach: sudo bash scripts/install_litellm.sh
# Leere Keys = Anbieter wird nicht genutzt. Alle Anbieter haben kostenlose Kontingente (Stand Okt. 2026, Limits ändern sich):
#   Groq        https://console.groq.com/keys            (schnell, Llama 3.3 70B)
#   Gemini      https://aistudio.google.com/apikey       (Gemini Flash)
#   Cerebras    https://cloud.cerebras.ai                (sehr schnell)
#   OpenRouter  https://openrouter.ai/settings/keys      (:free-Modelle, ~50 Anfragen/Tag ohne Guthaben)
# Achtung: Bei kostenlosen Kontingenten dürfen manche Anbieter Eingaben zum Training nutzen – über FreeLLM gehen
# nur Chat-Antworten bei leerem Pro-Kontingent, keine Mails/Kalender (Connectors) und keine Server-Tools.
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# wird von install_litellm.sh erzeugt und in /etc/lifeos-agent/agent.env (FREE_LLM_KEY) übernommen
LITELLM_MASTER_KEY=
